    {
      "id": "M01",
      "case": "dynamicRef.json:0:A $dynamicRef to a $dynamicAnchor in the same schema resource behaves like a normal $ref to an $anchor",
      "description": "An array of strings is valid",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://test.json-schema.org/dynamicRef-dynamicAnchor-same-schema/root",
        "type": "array",
        "items": {
          "$dynamicRef": "#items"
        },
        "$defs": {
          "foo": {
            "$dynamicAnchor": "items",
            "type": "string"
          }
        }
      },
      "value": [
        "foo",
        "bar"
      ],
      "expected": true,
      "closureDigest": "sha256:e56c4a9ca922c70bcb71308579b77c09c8804a3631f045a8e420a17f03bd680b"
    },
